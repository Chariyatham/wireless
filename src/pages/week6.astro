---
import Base from '../layouts/Base.astro';
import Step from '../components/Step.astro';
import WeekNav from '../components/WeekNav.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  { id: 'why', label: 'ทำไมต้องแผ่สเปกตรัม' },
  { id: 'chain', label: '🎬 สายโซ่ระบบแผ่' },
  { id: 'gain', label: 'ได้อะไรจากการ "ไม่คุ้ม"' },
  { id: 'split', label: 'FHSS vs DSSS' },
  { id: 'fhss', label: 'FHSS — กระโดดความถี่' },
  { id: 'fhmfsk', label: '🎬 FH ช้า vs เร็ว' },
  { id: 'fhperf', label: 'ทำไมทนการแจม' },
  { id: 'dsss', label: '🎬 DSSS — ลำดับตรง' },
  { id: 'dsssbpsk', label: 'DSSS ด้วย BPSK + สเปกตรัม' },
  { id: 'cdma', label: 'CDMA — แบ่งด้วยรหัส' },
  { id: 'cdmaex', label: '🎬 ตาราง 7.1 ทีละกรณี' },
  { id: 'cdmaprob', label: '📝 โจทย์ CDMA (สไลด์ 30)' },
  { id: 'seq', label: 'ชนิดของลำดับการแผ่' },
  { id: 'pn', label: 'PN sequence + คุณสมบัติ' },
  { id: 'lfsr', label: '🎬 วงจรสร้าง PN' },
  { id: 'mseq', label: 'M-sequence + R(τ)' },
  { id: 'gold', label: 'Cross correlation · Gold' },
  { id: 'walsh', label: '🧪 Walsh / รหัสตั้งฉาก' },
  { id: 'ovsf', label: 'OVSF — โค้ดยาวไม่เท่ากัน' },
  { id: 'multi', label: 'Multiple spreading 2 ชั้น' },
  { id: 'pneval', label: '📝 ประเมินรหัส 15 บิต' },
  { id: 'real', label: '🌍 ของจริงที่ใช้อยู่' },
  { id: 'fast', label: '⚡ คิดไวในห้องสอบ' },
  { id: 'code', label: '💻 โค้ดรันได้' },
  { id: 'exam', label: '✸ ข้อสอบจับเวลา' },
  { id: 'check', label: 'เช็กเข้าใจ' },
  { id: 'summary', label: 'สรุป' },
];
---
<Base title="Week 6 — การแผ่สเปกตรัม (Spread Spectrum)">
  <main class="wrap">
    <div class="crumb"><a href={`${base}/`}>หน้าแรก</a> / Week 6</div>
    <h2>Week 6 · การแผ่สเปกตรัม (Spread Spectrum)</h2>
    <p class="hint">FHSS (กระโดดความถี่) · DSSS (ลำดับตรง) · CDMA · PN sequence / m-sequence / Gold · Walsh + OVSF · การประเมินรหัสสุ่มเทียม<br/>
      🔇 <b>ที่มา:</b> สไลด์ 1–53 ของ รศ.ดร.ธนภัทร์ อนุศาสน์อมรกุล — <b>คาบนี้ไม่มีไฟล์เสียง</b> จึง<b>เรียบเรียงจากสไลด์ล้วน ไม่มีกล่อง 🎙 (ไม่เดาคำพูดอาจารย์)</b> · ทุกจุดที่เกินสไลด์ติดป้าย <span class="plus">เสริมจากผู้เขียน</span> ให้เห็นชัด</p>

    <div class="shell">
      <WeekNav week={6} sections={sections} />
      <div class="lesson-main">

        <!-- ============ 1 ============ -->
        <Step kind="real" icon="🎯" title="ปัญหาที่บทนี้แก้: จะทำยังไงให้ 'ถูกกวนไม่ได้' และ 'อยู่ร่วมกันได้'" id="why">
          <p>Week 5 จบลงที่การเอาบิตยัดใส่คลื่นให้<b>คุ้มแบนด์วิดท์ที่สุด</b> — QAM ยิ่งหลายระดับ ยิ่งได้ bps ต่อ Hz เยอะ นั่นคือเป้าหมายตลอดห้าสัปดาห์ที่ผ่านมา</p>
          <p>Week 6 กลับหัวความคิดนั้นทั้งหมด: <b>เราจะจงใจใช้แบนด์วิดท์ให้กว้างกว่าที่จำเป็นหลายเท่า</b> — เปลืองอย่างตั้งใจ</p>
          <div class="note">สไลด์ 5 ตั้งคำถามนี้ตรง ๆ: <b>"อะไรที่ได้เพิ่มมาจากการใช้สเปกตรัมอย่างไม่คุ้มค่า"</b> — ทั้งบทคือคำตอบของประโยคนี้</div>
          <p class="why"><b>ทำไมวิศวกรคอมต้องรู้?</b> เพราะเทคนิคในบทนี้คือสิ่งที่ทำให้ของรอบตัวทำงานได้: Wi-Fi 802.11b ใช้ DSSS · Bluetooth ใช้ FHSS กระโดด 1,600 ครั้งต่อวินาที · GPS ใช้รหัสแผ่จึงทำให้สัญญาณดาวเทียมที่<b>อ่อนกว่าสัญญาณรบกวนพื้นหลัง</b>ยังถอดออกมาได้ · และ 3G ทั้งระบบสร้างบน CDMA <span class="plus">เสริมจากผู้เขียน — สไลด์ไม่ได้ยกตัวอย่างเหล่านี้</span></p>
          <p>สามคำถามที่ต้องตอบให้ได้เมื่อจบบท: <b>(1)</b> แผ่แล้วได้อะไร <b>(2)</b> แผ่ได้กี่วิธี ต่างกันยังไง <b>(3)</b> "รหัส" ที่ใช้แผ่ต้องมีคุณสมบัติอะไร ถึงจะเรียกว่าใช้ได้</p>
        </Step>

        <!-- ============ 2 ============ -->
        <Step kind="anim" icon="⛓" title="สายโซ่ของระบบแผ่สเปกตรัม — แคบ → กว้าง → แคบ" id="chain">
          <p>สไลด์ 2–4 เล่าเป็นสองทิศทาง ฝั่งส่งกับฝั่งรับ กดเล่นดูทีละกล่อง:</p>
          <div id="chainStepper6"></div>
          <p><b>ฝั่งส่ง (สไลด์ 2):</b> อินพุตถูกส่งเข้าไปในตัวเข้ารหัสสัญญาณ → จะสร้าง<b>สัญญาณแอนะล็อกที่มีแบนด์วิดท์แคบ</b> → จากนั้นสัญญาณถูกมอดูเลตโดยใช้<b>ลำดับของเลขโดด</b> (sequence of digits) → ผลของการมอดูเลตคือ<b>เพิ่มแบนด์วิดท์ของสัญญาณสำหรับส่ง</b></p>
          <p><b>ฝั่งรับ (สไลด์ 3):</b> ลำดับของเลขโดดชุดเดิมถูกใช้มอดูเลตสัญญาณการแผ่สเปกตรัม → สัญญาณถูกส่งเข้าไปในตัวถอดรหัสช่องสัญญาณเพื่อนำข้อมูลกลับมา</p>
          <div class="formula">คำศัพท์ 3 คำที่หมายถึงสิ่งเดียวกัน (สไลด์ 2):

  รหัสการแผ่ (spreading code)  =  ลำดับของการแผ่ (spread sequence)

  สร้างโดย: สัญญาณรบกวนเทียม (pseudo noise)
            หรือ ตัวสร้างหมายเลขสุ่มเทียม (pseudo random number generator)</div>
          <p class="why"><b>อ่านสายโซ่นี้ให้เป็นภาพเดียว:</b> พลังงานทั้งหมดเท่าเดิม แต่ถูก "รีดแผ่" ออกไปกว้าง ๆ เหมือนเอาแป้งก้อนเดียวมารีดเป็นแผ่นบาง — สูงลดลงจนจมอยู่ในระดับ noise คนที่ไม่รู้รหัสจะมองไม่เห็นว่ามีสัญญาณอยู่ตรงนั้นด้วยซ้ำ <span class="plus">เสริมจากผู้เขียน — อุปมาช่วยจำ</span></p>
        </Step>

        <!-- ============ 3 ============ -->
        <Step kind="intu" icon="🎁" title="ได้อะไรจากการ 'ใช้สเปกตรัมอย่างไม่คุ้มค่า' — 3 ข้อในสไลด์ 5" id="gain">
          <table class="tbl">
            <thead><tr><th>สิ่งที่ได้ (สไลด์ 5)</th><th>แปลเป็นภาษาคน</th><th>ใครใช้ข้อนี้</th></tr></thead>
            <tbody>
              <tr><td><b>มีภูมิคุ้มกันจากสัญญาณรบกวนหลาย ๆ ชนิด และการเพี้ยนจากหลายวิถี (multi-path distortion)</b></td><td>ตัวกวนมักกระจุกอยู่แคบ ๆ พอเรากระจายไปกว้าง ตัวกวนจึงทำลายได้แค่ส่วนน้อยของสัญญาณ · ส่วน multipath (Week 4) ก็แยกแยะออกได้เพราะสำเนาที่มาช้าจะ "ไม่ตรงรหัส"</td><td>Wi-Fi ในตึกที่คลื่นสะท้อนเต็มไปหมด</td></tr>
              <tr><td><b>สามารถใช้ซ่อนและเข้ารหัสลับสัญญาณ</b></td><td>ถ้าไม่รู้รหัส จะเห็นแค่ "พื้น noise" ไม่รู้ด้วยซ้ำว่ามีการส่งอยู่</td><td>ทหาร · GPS</td></tr>
              <tr><td><b>ผู้ใช้หลาย ๆ คนสามารถใช้แบนด์วิดท์ที่มากขึ้นช่วงเดียวกันได้อย่างอิสระ โดยมีการแทรกสอดต่ำ</b></td><td>ทุกคนส่งพร้อมกัน บนความถี่เดียวกัน แต่คนละรหัส → นี่คือ CDMA ทั้งดุ้น</td><td>3G ทั้งระบบ</td></tr>
            </tbody>
          </table>
          <p class="why"><b>ข้อ 3 คือข้อที่พลิกวงการที่สุด</b> — ก่อนหน้านี้เราแบ่งทรัพยากรได้ 2 แกนคือ<b>ความถี่</b> (FDM, Week 3) และ<b>เวลา</b> (TDM, Week 3) · บทนี้เปิดแกนที่สาม คือ<b>รหัส</b> — ทุกคนใช้ความถี่เดียวกัน เวลาเดียวกัน แต่แยกกันด้วยรหัสที่ตั้งฉากกัน</p>
        </Step>

        <!-- ============ 4 ============ -->
        <Step kind="intu" icon="🔀" title="แบ่งการแผ่สเปกตรัมได้ 2 ชนิด (สไลด์ 6)" id="split">
          <table class="tbl">
            <thead><tr><th></th><th>FHSS</th><th>DSSS</th></tr></thead>
            <tbody>
              <tr><td><b>ชื่อเต็ม</b></td><td>การแผ่สเปกตรัมการกระโดดเปลี่ยนความถี่<br/><i>Frequency hopping spread spectrum</i></td><td>การแผ่สเปกตรัมแบบลำดับตรง<br/><i>Direct sequence spread spectrum</i></td></tr>
              <tr><td><b>วิธีแผ่</b></td><td><b>ย้ายความถี่ไปมา</b> ตามลำดับที่รหัสกำหนด</td><td><b>แตกทุกบิตเป็นหลายชิป</b> ด้วย XOR กับรหัส</td></tr>
              <tr><td><b>ที่ใดที่หนึ่งเวลาหนึ่ง</b></td><td>อยู่ใน <b>1 ช่องสัญญาณ</b> เท่านั้น (สไลด์ 8)</td><td>อยู่ <b>ทั่วทั้งแถบกว้าง</b> พร้อมกัน</td></tr>
              <tr><td><b>อุปมา</b> <span class="plus">เสริม</span></td><td>เปลี่ยนโต๊ะคุยไปเรื่อย ๆ ตามตารางลับที่ทั้งคู่ถืออยู่</td><td>พูดพร้อมกัน 11 คนด้วยประโยคที่ตกลงกันไว้ แล้วให้ปลายทางกรองออก</td></tr>
            </tbody>
          </table>
        </Step>

        <!-- ============ 5 ============ -->
        <Step kind="deep" icon="🐸" title="FHSS — สัญญาณกระโดดไปตามลำดับสุ่มของความถี่วิทยุ" id="fhss">
          <p>สไลด์ 7 วางหลักการไว้ 4 บรรทัด:</p>
          <ul>
            <li>สัญญาณถูกกระจายออกไปเป็น<b>ลำดับที่สุ่มของความถี่วิทยุ</b> — ช่องสัญญาณหลาย ๆ ช่องถูกจองไว้สำหรับสัญญาณ FH · <b>ความกว้างของแต่ละช่องสัญญาณขึ้นอยู่กับแบนด์วิดท์ของสัญญาณขาเข้า</b></li>
            <li>สัญญาณกระโดดจากความถี่หนึ่งไปอีกความถี่หนึ่งโดยมี<b>ช่วงเวลาที่คงที่</b></li>
            <li><b>รหัสการแผ่เป็นตัวกำหนดลำดับของช่องสัญญาณ</b></li>
            <li>ตัวรับที่กระโดดระหว่างความถี่<b>ในการกำหนดจังหวะกับตัวส่ง</b> จะเก็บข้อความขึ้นมา</li>
          </ul>
          <p>และสไลด์ 8 เพิ่มรายละเอียดฝั่งส่ง: <b>ตัวส่งทำงานใน 1 ช่องสัญญาณในแต่ละครั้ง</b> · บิตถูกส่งโดยใช้แบบแผนการเข้ารหัส (encoding scheme) · <b>ในแต่ละช่วงเวลาที่สำเร็จ ความถี่พาห์อันใหม่จะถูกเลือกมา</b></p>
          <div class="note">📌 <b>ข้อดี 2 ข้อที่สไลด์ 7 ระบุ:</b> ① คนแอบดักฟังได้ยินเพียงแค่ช่วงเวลาไม่นาน ② การพยายามแจมช่องสัญญาณ ทำได้แค่ใน 1 ช่องความถี่ ทำให้ไม่ได้รับเพียงไม่กี่บิต</div>
          <p><b>ผังระบบ (สไลด์ 9–10):</b> ฝั่งส่ง Binary data → Modulator (FSK หรือ BPSK) ได้ s_d(t) → <b>FH spreader</b> คูณกับ c(t) ที่มาจาก Frequency Synthesizer ซึ่งถูกคุมโดย <b>Pseudonoise bit source → Channel Table</b> → ผ่าน Bandpass filter (รอบความถี่<b>ผลบวก</b>) → ออกเป็นสัญญาณแผ่สเปกตรัม s(t)</p>
          <p>ฝั่งรับทำกลับกันเป๊ะ: <b>FH despreader</b> คูณด้วย c(t) ตัวเดียวกัน → Bandpass filter (รอบความถี่<b>ผลต่าง</b>) → Demodulator (FSK/BPSK) → ได้ binary data คืน · จุดที่ต้องสังเกตคือ <b>ทั้งสองฝั่งใช้ Pseudonoise bit source + Channel Table ชุดเดียวกัน</b> — นี่คือ "กุญแจ" ของระบบ</p>
        </Step>

        <!-- ============ 6 ============ -->
        <Step kind="anim" icon="🎹" title="FHSS โดยใช้ MFSK — ช้าหรือเร็ว ดูที่ T_c เทียบ T_s" id="fhmfsk">
          <p>สไลด์ 11 บอกว่าสัญญาณ MFSK จะถูกแปลงไปเป็นความถี่ใหม่<b>ทุก ๆ T_c วินาที</b> โดยการมอดูเลตสัญญาณ MFSK กับสัญญาณพาห์ของ FHSS แล้วให้สูตรมา 3 บรรทัด:</p>
          <div class="formula">สำหรับอัตราการส่งข้อมูล R

    คาบของบิต       T   = 1 / R   วินาที
    คาบของสัญลักษณ์  T_s = L · T    วินาที       (L = บิตต่อสัญลักษณ์ = log₂M)

    T_c ≥ T_s   →   FHSS แบบช้า  (slow)
    T_c <  T_s   →   FHSS แบบเร็ว (fast)</div>
          <p>กดเล่นดู — ตัวเลขทุกตัวมาจากสไลด์ 12 (slow) และสไลด์ 13 (fast) โดยตรง ข้อมูลชุดเดียวกันทั้งคู่:</p>
          <div id="fhStepper"></div>
          <p class="why"><b>กุญแจของภาพนี้:</b> แกนความถี่ถูกแบ่งเป็น <b>4 แถบ (W_d)</b> แถบละ <b>4 โทน</b> รวม W_s = 4W_d = 16 ช่อง — <b>รหัส PN เลือกว่าอยู่แถบไหน · สัญลักษณ์ MFSK เลือกว่าอยู่โทนไหนในแถบนั้น</b> สองชั้นซ้อนกัน นี่คือความหมายของคำว่า "FHSS โดยใช้ MFSK"</p>
          <div id="walkFH"></div>
        </Step>

        <!-- ============ 7 ============ -->
        <Step kind="intu" icon="⚡" title="การพิจารณาความสามารถของ FHSS — ทำไมแจมไม่ลง (สไลด์ 14)" id="fhperf">
          <ul>
            <li><b>ใช้ความถี่จำนวนมาก</b></li>
            <li><b>ทำให้ระบบมีความทนทานต่อสัญญาณกวน (jamming)</b> — การแจมต้องทำ<b>ทุก ๆ ความถี่</b> · ถ้ากำลังส่งคงที่ การแจมจะ<b>ลดกำลังส่งในการแจมลงในทุก ๆ 1 แถบความถี่</b></li>
          </ul>
          <p class="why"><b>อ่านประโยคที่สองให้เป็นตัวเลข:</b> ศัตรูมีกำลังจำกัด P ก้อนเดียว จะเลือกได้แค่สองทาง — ทุ่มใส่แถบเดียวเต็มแรง (แต่เราอยู่แถบนั้นแค่ 1/4 ของเวลา) หรือกระจายให้ครบ 4 แถบ (แต่เหลือแรงแถบละ P/4) · <b>ไม่ว่าเลือกทางไหน ศัตรูก็เสียเปรียบทั้งคู่</b> — ยิ่งเรามีแถบเยอะ ยิ่งบีบให้เขาเลือกยาก <span class="plus">เสริมจากผู้เขียน — สไลด์บอกหลักการไว้ ส่วนการคิดเป็นสัดส่วนเป็นการขยายความ</span></p>
        </Step>

        <!-- ============ 8 ============ -->
        <Step kind="anim" icon="✳️" title="DSSS — แตกทุกบิตเป็นหลายชิปด้วย exclusive-OR" id="dsss">
          <p>สไลด์ 15 วางหลักการไว้ 3 บรรทัด: <b>แต่ละบิตของข้อมูลถูกแทนที่โดยใช้หลาย ๆ บิตในการส่งสัญญาณ</b> · <b>รหัสการแผ่ทำให้แผ่สัญญาณไปทั่วทั้งแถบความถี่กว้างขึ้น</b> โดย<b>การแผ่อยู่ในสัดส่วนตรงกับจำนวนบิตที่ใช้</b> · และเทคนิคที่ใช้รวมสายข้อมูลดิจิทัลกับสายบิตของรหัสการแผ่คือ <b>exclusive-OR (⊕)</b></p>
          <div id="dsssStepper"></div>
          <p><b>ทำไม XOR สองรอบถึงได้ของเดิม?</b> เพราะ XOR มีสมบัติ <code>(A ⊕ B) ⊕ B = A</code> เสมอ — B ที่ใส่เข้าไปตอนส่ง ถูก B ตัวเดิมลบทิ้งตอนรับ · <b>ใครไม่มี B ก็ถอดไม่ได้</b> เพราะสิ่งที่เขาเห็นคือลำดับที่ดูเหมือนสุ่มล้วน ๆ</p>
          <div class="note">📌 <b>อัตราชิป (สไลด์ 22):</b> ถ้าอัตราของสัญญาณข้อมูล = D และแตกแต่ละบิตให้อยู่ใน k ชิป (chip) แล้ว <b>อัตราส่งชิปของช่องสัญญาณใหม่ = k × D</b> — "ชิป คือ รูปแบบที่คงที่ที่กำหนดให้ผู้ใช้"</div>
        </Step>

        <!-- ============ 9 ============ -->
        <Step kind="deep" icon="📐" title="DSSS โดยใช้ BPSK — สมการที่อยู่หลังภาพ (สไลด์ 17–20)" id="dsssbpsk">
          <div class="formula">สัญญาณ BPSK ปกติ (ยังไม่แผ่):

    s_d(t) = A · d(t) · cos(2π f_c t)

        A    = แอมพลิจูดของสัญญาณ
        f_c  = ความถี่คลื่นพาห์
        d(t) = discrete function ที่มีค่า [+1, −1]

คูณรหัสการแผ่ c(t) เข้าไป  (c(t) มีค่า [+1, −1]):

    s(t) = A · d(t) · c(t) · cos(2π f_c t)

ที่ตัวรับ สัญญาณที่รับเข้ามาจะถูกคูณโดย c(t) อีกครั้ง:

    โดยที่  c(t) × c(t) = 1   →  สัญญาณที่รับเข้ามาสามารถเรียกกลับมาได้</div>
          <p class="why"><b>บรรทัดที่สำคัญที่สุดคือ c(t) × c(t) = 1</b> — เพราะ c(t) เป็นได้แค่ +1 หรือ −1 การคูณตัวเองจึงได้ 1 เสมอ (ทั้ง (+1)² และ (−1)²) · นี่คือ<b>เวอร์ชันคูณของสมบัติ XOR สองรอบ</b>ที่เราเพิ่งเห็น — แนวคิดเดียวกัน คนละภาษาคณิตศาสตร์ <span class="plus">เสริมจากผู้เขียน — การเชื่อมสองมุมมองนี้เข้าด้วยกัน</span></p>
          <p><b>สเปกตรัมที่ได้ (สไลด์ 20):</b></p>
          <table class="tbl">
            <thead><tr><th>สัญญาณ</th><th>ความกว้างสเปกตรัม</th><th>ความหมาย</th></tr></thead>
            <tbody>
              <tr><td>(a) สัญญาณข้อมูล</td><td>−1/T ถึง +1/T</td><td>แคบ สูง — พลังงานกระจุก</td></tr>
              <tr><td>(b) สัญญาณ pseudonoise</td><td>−1/T_c ถึง +1/T_c</td><td>กว้างกว่ามาก เพราะ T_c &lt; T</td></tr>
              <tr><td>(c) สัญญาณรวม</td><td>−(1/T + 1/T_c) ถึง +(1/T + 1/T_c)</td><td>กว้างที่สุด เตี้ยที่สุด — จมใน noise</td></tr>
            </tbody>
          </table>
          <p>เนื่องจาก T_c เล็กกว่า T อยู่ k เท่า (k = ชิปต่อบิต) ตัว 1/T_c จึงใหญ่กว่า 1/T อยู่ k เท่า → <b>แบนด์วิดท์ที่ต้องใช้โตขึ้นประมาณ k เท่า</b> นี่คือราคาที่จ่ายไปเพื่อแลกกับข้อดี 3 ข้อในสไลด์ 5</p>
        </Step>

        <!-- ============ 10 ============ -->
        <Step kind="deep" icon="🔑" title="CDMA — การเข้าถึงหลายทางแบบแบ่งรหัส" id="cdma">
          <p>สไลด์ 22 วางหลักการพื้นฐานไว้ 3 บรรทัด:</p>
          <ul>
            <li><b>D = อัตราของสัญญาณข้อมูล</b></li>
            <li><b>แตกแต่ละบิตให้อยู่ใน k ชิป (chip)</b> — ชิป คือ รูปแบบที่คงที่ที่กำหนดให้ผู้ใช้</li>
            <li><b>อัตราส่งชิปของช่องสัญญาณใหม่ = k × D</b></li>
          </ul>
          <p>และสไลด์ 23 บอกกฎการส่งกับกฎการถอด ซึ่งเป็นหัวใจทั้งหมดของ CDMA:</p>
          <div class="formula">กฎการส่ง (ถ้า k = 6 และโค้ดคือลำดับของ 1 และ 0):

    ส่ง บิต 1  →  ส่งโค้ดเป็นแบบรูปชิป (chip pattern)
                  ⟨c₁, c₂, c₃, c₄, c₅, c₆⟩

    ส่ง บิต 0  →  ส่งโค้ดที่เป็นส่วนกลับของแบบรูปชิป
                  ⟨−c₁, −c₂, −c₃, −c₄, −c₅, −c₆⟩

กฎการถอด — ตัวรับรู้โค้ดของตัวส่ง และใช้ฟังก์ชันนี้:

    S(d) = d₁·c₁ + d₂·c₂ + d₃·c₃ + d₄·c₄ + d₅·c₅ + d₆·c₆

        ⟨d₁ … d₆⟩ = แบบรูปชิปที่ได้รับ
        ⟨c₁ … c₆⟩ = โค้ดของตัวส่ง</div>
          <p class="why"><b>อ่านฟังก์ชันถอดรหัสให้เป็นภาษาคน:</b> มันคือ "<b>เอาสิ่งที่ได้ยิน มาเทียบว่าเหมือนรหัสของคนที่เราสนใจแค่ไหน</b>" — เหมือนมากได้ค่าบวกสูง เหมือนกลับหัวได้ค่าลบสูง ไม่เกี่ยวกันเลยได้ศูนย์ · ซึ่งตรงกับนิยาม correlation ในสไลด์ 39 พอดี</p>
        </Step>

        <!-- ============ 11 ============ -->
        <Step kind="anim" icon="👥" title="ตาราง 7.1 — เดินทีละกรณีจนเห็นว่าทำไมมันไม่กวนกัน" id="cdmaex">
          <p>สไลด์ 23–26 ยกตัวอย่างผู้ใช้ 3 คนที่รหัสยาว 6 ชิป กดเล่นทีละกรณี (a) → (e):</p>
          <div id="cdmaStepper"></div>
          <table class="tbl">
            <thead><tr><th>กรณี (สไลด์ 26)</th><th>ใครส่ง</th><th>ตัวรับถอดของใคร</th><th>ผลรวม</th><th>อ่านว่า</th></tr></thead>
            <tbody>
              <tr><td>(b)</td><td>A ส่งบิต 1</td><td>A</td><td><b>6</b></td><td>บิต 1 ✓</td></tr>
              <tr><td>(b)</td><td>A ส่งบิต 0</td><td>A</td><td><b>−6</b></td><td>บิต 0 ✓</td></tr>
              <tr><td>(c)</td><td>B ส่งบิต 1</td><td>A</td><td><b>0</b></td><td>สัญญาณที่ไม่ต้องการ ไม่ต้องสนใจ</td></tr>
              <tr><td>(d)</td><td>C ส่งบิต 1</td><td>B</td><td><b>2</b></td><td>⚠︎ ไม่ใช่ 0 — ดูคำอธิบายล่าง</td></tr>
              <tr><td>(e)</td><td>B และ C ส่งพร้อมกัน</td><td>B</td><td><b>8</b></td><td>บิต 1 ✓ (ยังอ่านถูก)</td></tr>
            </tbody>
          </table>
          <div class="note">⚠︎ <b>กรณี (d) คือจุดที่ต้องเข้าใจให้ลึก:</b> ได้ <b>2</b> ไม่ใช่ 0 เพราะรหัส B กับ C <b>ไม่ได้ตั้งฉากกันสนิท</b> · มันยัง "พอใช้ได้" เพราะ 2 ห่างจาก 6 มาก ตัวรับจึงยังตัดสินไม่ผิด — แต่ถ้าเพิ่มผู้ใช้ไปเรื่อย ๆ ค่าขยะแบบนี้จะสะสมจนอ่านพลาด · <b>นี่คือเหตุผลที่ต้องมี "รหัสตั้งฉาก" (Walsh) ในสไลด์ 44</b></div>
          <p><b>กรณี (e) คือปาฏิหาริย์ของ CDMA:</b> B กับ C ส่งพร้อมกัน สัญญาณในอากาศบวกกันเป็น (2, 2, −2, 0, 2, 0) ซึ่ง<b>ไม่เหมือนรหัสของใครเลย</b> — แต่พอคูณด้วยรหัส B แล้วรวม กลับได้ 8 ซึ่งยังอ่านว่า "บิต 1" ได้ถูกต้อง</p>
        </Step>

        <!-- ============ 12 ============ -->
        <Step kind="check" icon="📝" title="โจทย์สไลด์ 30 — เดินมือทีละขั้นจนได้คำตอบ" id="cdmaprob">
          <div class="note" style="max-width:100%">📌 <b>โจทย์ในสไลด์ 30 (โจทย์เดียวของบทนี้):</b> ในระบบ CDMA ถ้าผู้ใช้ A มีรหัส <b>0011</b> ส่ง<b>บิต 0</b> และผู้ใช้ B มีรหัส <b>0101</b> ส่ง<b>บิต 1</b> ออกไปในอากาศ จงหาสัญญาณที่รวมกันในอากาศ และเครื่องรับสามารถเอาข้อมูลที่ผู้ใช้ A ออกมาได้อย่างไร</div>
          <div id="walkCDMA"></div>
          <div class="formula">สรุปคำตอบ

  สัญญาณรวมในอากาศ  =  ( 0, +2, −2, 0 )

  ถอดของ A:  (0)(−1) + (2)(−1) + (−2)(+1) + (0)(+1) = −4  →  ติดลบ = บิต 0 ✓
  ถอดของ B:  (0)(−1) + (2)(+1) + (−2)(−1) + (0)(+1) = +4  →  เป็นบวก = บิต 1 ✓</div>
          <p class="why"><b>ทำไมข้อนี้ออกสอบง่ายมาก:</b> เพราะมันบังคับให้แสดงครบทุกทักษะของบท — แปลงไบโพลาร์ · รู้กฎบิต 0 = กลับขั้ว · บวกสัญญาณในอากาศ · ใช้ฟังก์ชันถอดรหัส · และตีความเครื่องหมาย · ถ้าทำข้อนี้ได้คล่อง แทบจะครอบคลุมส่วน CDMA ทั้งหมด <span class="plus">เสริมจากผู้เขียน — ข้อสังเกตเชิงกลยุทธ์</span></p>
          <details class="sol"><summary>💡 ลองเองก่อนดู: ถ้า A ส่ง<b>บิต 1</b> แทน (B เหมือนเดิม) สัญญาณรวมจะเป็นเท่าไหร่?</summary><div class="body">
            <div class="formula">A ส่งบิต 1 → ส่งรหัสตรง ๆ = (−1, −1, +1, +1)
B ส่งบิต 1 → (−1, +1, −1, +1)

รวม = (−2, 0, 0, +2)

ถอด A: (−2)(−1) + (0)(−1) + (0)(+1) + (2)(+1) = 2 + 0 + 0 + 2 = +4 → บิต 1 ✓
ถอด B: (−2)(−1) + (0)(+1) + (0)(−1) + (2)(+1) = 2 + 0 + 0 + 2 = +4 → บิต 1 ✓</div>
            <p>สังเกตว่าสัญญาณรวมเปลี่ยนไปคนละชุด แต่<b>ทั้งสองคนยังถอดได้ถูกต้อง</b> — ความตั้งฉากทำงานโดยไม่สนว่าใครส่งบิตอะไร</p>
          </div></details>
        </Step>

        <!-- ============ 13 ============ -->
        <Step kind="intu" icon="🗃" title="ชนิดของลำดับการแผ่ — ใช้อันไหนกับระบบไหน (สไลด์ 31)" id="seq">
          <p>ลำดับการแผ่แบ่งได้เป็น <b>PN sequence</b> กับ <b>Orthogonal codes</b> แล้วสไลด์ 31 ก็จับคู่ให้เลยว่าระบบไหนใช้อะไร:</p>
          <table class="tbl">
            <thead><tr><th>ระบบ</th><th>ลำดับที่ใช้</th></tr></thead>
            <tbody>
              <tr><td>สำหรับระบบ <b>FHSS</b></td><td>PN sequence ถูกใช้มากสุด</td></tr>
              <tr><td>สำหรับระบบ <b>DSSS แต่ไม่ใช่ CDMA</b></td><td>PN sequence ถูกใช้มากสุด</td></tr>
              <tr><td>สำหรับระบบ <b>DSSS ที่ใช้ CDMA</b></td><td>PN sequence <b>และ</b> Orthogonal codes</td></tr>
            </tbody>
          </table>
          <p class="why"><b>อ่านตารางนี้ให้เห็นตรรกะ:</b> ถ้าไม่ต้องแยกผู้ใช้หลายคน แค่ต้องการ "ลำดับที่ดูสุ่ม" ก็พอ → PN · แต่พอต้องให้หลายคนใช้พร้อมกันโดยไม่กวนกัน ความ "ดูสุ่ม" ไม่พอ ต้อง<b>ตั้งฉากกันจริง ๆ</b> ด้วย → จึงต้องใช้ทั้งคู่ ซึ่งเป็นที่มาของ multiple spreading ในสไลด์ 49 <span class="plus">เสริมจากผู้เขียน — การเชื่อมโยงเหตุผล</span></p>
        </Step>

        <!-- ============ 14 ============ -->
        <Step kind="deep" icon="🎲" title="PN sequence — สุ่มที่ไม่ได้สุ่ม แต่เดาไม่ออก" id="pn">
          <p>สไลด์ 32 นิยามไว้ว่า ตัวสร้าง PN จะสร้าง<b>ลำดับเป็นคาบที่ดูเหมือนจะเป็นลำดับสุ่ม</b> โดย:</p>
          <ul>
            <li><b>ใช้อัลกอริทึมสร้าง โดยใช้ seed เริ่มต้น</b></li>
            <li>ลำดับนี้<b>ไม่ใช่ว่าจะเป็นการสุ่มในทางสถิติ</b> แต่<b>ผ่านการทดสอบว่าเป็นความไม่มีแบบแผน (randomness)</b></li>
            <li>ลำดับนี้อ้างอิงถึง <b>ตัวเลขสุ่มเทียม (pseudorandom number)</b> หรือ <b>ลำดับของสัญญาณรบกวนเทียม</b></li>
            <li><b>ถ้าไม่รู้อัลกอริทึมและ seed ลำดับนี้ไม่มีทางคาดเดาได้เลย</b></li>
          </ul>
          <p class="why"><b>คำว่า "เทียม" (pseudo) สำคัญมาก</b> — ลำดับนี้<b>ซ้ำเดิมทุกครั้ง</b>ถ้าใส่ seed เดิม นั่นคือสิ่งที่เราต้องการ! เพราะฝั่งรับต้องสร้างลำดับ<b>เดียวกันเป๊ะ</b>ขึ้นมาเองได้ · ถ้ามัน "สุ่มจริง" ฝั่งรับจะสร้างตามไม่ได้เลย ระบบก็พัง <span class="plus">เสริมจากผู้เขียน — จุดที่คนสับสนบ่อย</span></p>
          <p><b>คุณสมบัติของ PN ที่สำคัญ (สไลด์ 33)</b> แบ่งเป็นสองหัวใหญ่:</p>
          <table class="tbl">
            <thead><tr><th>หัวข้อ</th><th>รายละเอียดในสไลด์</th></tr></thead>
            <tbody>
              <tr><td rowspan="3"><b>ความไม่มีแบบแผน<br/>(randomness)</b></td><td><b>การแจกแจงแบบเอกรูป (uniform distribution)</b> — มี ① <b>คุณสมบัติสมดุล</b>: สัดส่วนของไบนารี 1 มีค่าใกล้เคียง 1/2 · ② <b>คุณสมบัติรัน (run property)</b>: รัน คือ ลำดับของ 0 ทั้งหมด หรือ 1 ทั้งหมด → <b>1/2</b> ของรันมีความยาว 1 · <b>1/4</b> ยาว 2 · <b>1/8</b> ยาว 3 และต่อไป</td></tr>
              <tr><td><b>มีความเป็นอิสระ (independence)</b> — ไม่มีลำดับใดที่สามารถจะอ้างอิงไปสร้างลำดับอื่นได้</td></tr>
              <tr><td><b>คุณสมบัติสหสัมพันธ์ (correlation)</b></td></tr>
              <tr><td><b>ไม่สามารถคาดเดาได้<br/>(unpredictability)</b></td><td>ต่อให้เห็นลำดับที่ผ่านมาแล้วก็ทำนายตัวถัดไปไม่ได้ ถ้าไม่รู้อัลกอริทึม + seed</td></tr>
            </tbody>
          </table>
        </Step>

        <!-- ============ 15 ============ -->
        <Step kind="anim" icon="⚙️" title="วงจรสร้างลำดับ PN ด้วย Shift Register (สไลด์ 34–36)" id="lfsr">
          <p>สไลด์ 34 แสดงผังทั่วไป: shift register หลายตัวต่อกัน (B_n → B_(n−1) → … → B₀ → Output) โดยแต่ละขั้นมี <b>วงจรคูณ (×) ด้วยสัมประสิทธิ์ A_i</b> แล้วรวมกันด้วย <b>วงจร exclusive-OR (⊕)</b> ป้อนกลับเข้าหัว</p>
          <p>สไลด์ 35 ยกตัวอย่างจริง: shift register 4 ตัว ป้อนกลับด้วย <b>B₀ ⊕ B₁</b> (ตรงกับพหุนาม x⁴ + x + 1) กดเล่นดูทีละจังหวะนาฬิกา:</p>
          <div id="lfsrStepper"></div>
          <p>สไลด์ 36 แสดงตารางว่าเริ่มด้วย seed ไหน ได้ลำดับอะไร — เริ่ม <code>1000</code> ได้ <code>000100110101111</code> · เริ่ม <code>0100</code> ได้ <code>001001101011110</code> ฯลฯ · <b>ทุก seed ให้ลำดับเดียวกันแต่เริ่มคนละจุด</b> (เป็นการหมุนของกันและกัน) เพราะทั้งหมดวนอยู่บนวงเดียว</p>
          <p class="why"><b>ทำไมได้ยาว 15 พอดี?</b> register 4 บิตมีสถานะได้ 2⁴ = 16 แบบ แต่สถานะ <code>0000</code> ใช้ไม่ได้ (ป้อนกลับได้ 0 ตลอด ค้างอยู่ตรงนั้นตลอดกาล) → เหลือ <b>15 สถานะ</b> ที่วนครบพอดีก่อนซ้ำ นี่คือที่มาของคำว่า <b>maximal length</b> และสูตร N = 2ⁿ − 1 <span class="plus">เสริมจากผู้เขียน — สไลด์ให้ตารางไว้ แต่ไม่ได้อธิบายว่าทำไมต้อง −1</span></p>
        </Step>

        <!-- ============ 16 ============ -->
        <Step kind="deep" icon="📊" title="M-sequence — 4 คุณสมบัติ + ฟังก์ชันอัตสหสัมพันธ์" id="mseq">
          <p><b>คุณสมบัติของ Maximal-length sequences (สไลด์ 37–38):</b></p>
          <table class="tbl">
            <thead><tr><th>ข้อ</th><th>เนื้อหาในสไลด์</th><th>เช็กกับตัวอย่าง n = 4 (N = 15)</th></tr></thead>
            <tbody>
              <tr><td><b>1</b></td><td>จะมี <b>2ⁿ⁻¹</b> ของ 1 และ <b>2ⁿ⁻¹−1</b> ของ 0</td><td>1 มี 8 ตัว · 0 มี 7 ตัว ✓</td></tr>
              <tr><td><b>2</b></td><td>สำหรับวินโดว์ที่มีขนาด n ถูกเลื่อนไปตามเอาต์พุตสำหรับ N (= 2ⁿ−1) ครั้ง ในแต่ละ n ค่า จะปรากฏขึ้นเพียงครั้งเดียว <b>ยกเว้นสำหรับลำดับที่มีศูนย์ทั้งหมด</b></td><td>เลื่อนหน้าต่าง 4 บิตไป 15 ครั้ง เจอครบทุกค่ายกเว้น 0000 ✓</td></tr>
              <tr><td><b>3</b></td><td>Sequence จะมี 1 รอบของหนึ่งทั้งหมด ความยาว n · 1 รอบของศูนย์ทั้งหมด ความยาว n−1 · 1 รอบของหนึ่งทั้งหมดและศูนย์ทั้งหมด ความยาว n−2 · 2 รอบของแต่ละอย่าง ความยาว n−3 · … · 2<sup>n−3</sup> รอบ ความยาว 1</td><td>รัน 1111 (ยาว 4 = n) · รัน 000 (ยาว 3 = n−1) ✓</td></tr>
              <tr><td><b>4</b></td><td>ค่าของ periodic autocorrelation ของลำดับ ±1 (ดูสูตรด้านล่าง)</td><td>R(0) = 1 · R(τ≠0) = −1/15 ✓</td></tr>
            </tbody>
          </table>
          <div class="formula">คุณสมบัติที่ 4 — ค่าของ periodic autocorrelation ของลำดับ a ± 1 คือ

                ⎧   1        เมื่อ τ = 0, N, 2N, …
        R(τ) = ⎨
                ⎩ −1/N       มิฉะนั้น (otherwise)

สูตรในการคำนวณ Autocorrelation แบบคาบ:

                 1    N
        R(τ) =  ───   Σ   B_k · B_(k−τ)
                 N   k=1</div>
          <p><b>ความหมายของ correlation (สไลด์ 39):</b> เป็นหลักการของการหาค่าความเหมือนกันของกลุ่มของข้อมูลกับตัวเปรียบเทียบตัวอื่น <b>ค่ามีค่าระหว่าง −1 กับ 1</b></p>
          <ul>
            <li><b>1</b> — ลำดับที่สอง เหมือนกับ ลำดับที่ 1</li>
            <li><b>0</b> — ไม่มีความสัมพันธ์กันของทั้ง 2 ลำดับเลย</li>
            <li><b>−1</b> — ลำดับทั้งสองเหมือนกัน แต่ว่าเป็นภาพสะท้อนของกันและกัน</li>
          </ul>
          <p>ส่วน <b>cross correlation</b> คือการเปรียบเทียบระหว่าง 2 ลำดับจาก<b>ต้นทางต่างกัน</b> ไม่ใช่มาจากตัวก๊อปปี้โดยการเลื่อนของลำดับกับตัวมันเอง</p>
          <p class="why"><b>ทำไมกราฟสไลด์ 40 ถึงหน้าตาเป็นหนามแหลม ๆ?</b> เพราะ R(τ) พุ่งขึ้น <b>1</b> ที่ τ = 0 แล้วตกลงมาราบอยู่ที่ <b>−1/15</b> ตลอดทุกค่าอื่น — ความต่างที่ชันมากนี่แหละที่ทำให้ตัวรับ<b>หา "จังหวะที่ตรงกัน" ได้คมมาก</b> เหมือนหาเข็มในกองฟาง แต่เข็มเรืองแสง <span class="plus">เสริมจากผู้เขียน — อุปมาช่วยจำ</span></p>
        </Step>

        <!-- ============ 17 ============ -->
        <Step kind="intu" icon="🔗" title="ข้อดีของ cross correlation + Gold sequences (สไลด์ 41–43)" id="gold">
          <p><b>ข้อดีของ cross correlation ที่มีค่าต่ำ (สไลด์ 41):</b></p>
          <ul>
            <li>ค่าของ cross correlation ระหว่าง <b>m-sequence กับสัญญาณรบกวน</b> มีค่าต่ำ → <b>มีประโยชน์สำหรับตัวรับที่จะกรองเอาสัญญาณรบกวนออกไป</b></li>
            <li>ค่าของ cross correlation ระหว่าง <b>m-sequence สองตัว</b> มีค่าต่ำ → <b>มีประโยชน์สำหรับ CDMA แอปพลิเคชัน</b> ทำให้ตัวรับแยกความแตกต่างระหว่างสัญญาณการแผ่สเปกตรัมที่ถูกสร้างจาก m-sequence ที่ต่างกัน</li>
          </ul>
          <p><b>Gold sequences (สไลด์ 42–43):</b> สร้างโดยการนำ <b>สอง m-sequences มาทำการ XOR กันโดยมี clocking เวลาเดียวกัน</b> — ใช้ 2 shift register สร้าง 2 m-sequence แล้วทั้งสองก็ทำการ XOR กันในระดับบิต</p>
          <ul>
            <li><b>โค้ดมีคุณสมบัติ cross correlation ที่เหมาะสม</b></li>
            <li><b>เพียงวงจรง่าย ๆ ที่ต้องการใช้สร้างโค้ดที่แตกต่างกันได้มากมาย</b></li>
          </ul>
          <p class="why"><b>ทำไมต้องมี Gold ถ้ามี m-sequence อยู่แล้ว?</b> เพราะ m-sequence ที่ยาว N มีอยู่<b>จำนวนจำกัดมาก</b> — ถ้าต้องแจกรหัสให้ผู้ใช้เป็นหมื่นคน ของไม่พอ · Gold แก้ปัญหานี้ด้วยการเอา m-sequence สองเส้นมา XOR โดยเลื่อนเฟสต่างกัน → ได้รหัสใหม่เป็นจำนวนมากที่ยัง cross correlation ต่ำอยู่ ตรงกับที่สไลด์เขียนว่า "วงจรง่าย ๆ สร้างโค้ดที่แตกต่างกันได้มากมาย" · <b>GPS ใช้ Gold code ด้วยเหตุผลนี้เป๊ะ</b> <span class="plus">เสริมจากผู้เขียน — สไลด์บอกคุณสมบัติ แต่ไม่ได้บอกว่าแก้ปัญหาอะไร</span></p>
        </Step>

        <!-- ============ 18 ============ -->
        <Step kind="anim" icon="🧪" title="รหัสตั้งฉาก (Orthogonal codes) + Walsh — ลองกดเทียบเอง" id="walsh">
          <p>สไลด์ 44 นิยามสั้นแต่แรง: <b>Orthogonal codes คือชุดรหัสที่ Cross correlation คู่ใด ๆ มีค่าเป็น 0</b> — ถ้าเอาโค้ด 2 ชุดมาคูณกันในแต่ละตำแหน่งแล้วบวกกัน จะมีค่าเป็น 0</p>
          <ul>
            <li><b>ความยาวโค้ดคงที่ และแปรผันได้ ถูกใช้ในระบบ CDMA</b></li>
            <li>สำหรับ CDMA แอปพลิเคชัน <b>ผู้ใช้เคลื่อนที่แต่ละคนใช้ 1 ลำดับในชุดเป็นโค้ด spreading</b> → ทำให้เกิดค่า cross correlation มีค่าเป็น 0 ท่ามกลางผู้ใช้ทั้งหมด</li>
            <li><b>ชนิดของโค้ด:</b> Walsh codes · Variable-length orthogonal codes</li>
          </ul>
          <div class="formula">Walsh code ที่มีความยาว n ประกอบด้วย n แถวของเมตริกซ์ n × n (สไลด์ 45)

