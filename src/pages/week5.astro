---
import Base from '../layouts/Base.astro';
import Step from '../components/Step.astro';
import WeekNav from '../components/WeekNav.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  { id: 'why', label: 'ทำไมต้องมีเทคนิคเข้ารหัส' },
  { id: 'chain', label: '🎬 สายโซ่ระบบสื่อสาร' },
  { id: 'encmod', label: '⭐ Encoder vs Modulator' },
  { id: 'criteria', label: 'เกณฑ์ + ปัจจัยเปรียบเทียบ' },
  { id: 'terms', label: '🧪 bit rate vs baud rate' },
  { id: 'mod', label: '🎬 ASK · FSK · PSK · DPSK' },
  { id: 'mfsk', label: '🎬 MFSK + โจทย์ 8 ความถี่' },
  { id: 'mpsk', label: 'QPSK / multilevel PSK' },
  { id: 'qam', label: '🎬 QAM + constellation' },
  { id: 'perf', label: '🧪 แบนด์วิดท์ + ประสิทธิภาพ' },
  { id: 'analog', label: '🎬 AM · FM · PM · SSB' },
  { id: 'pcm', label: '🎬 PCM + โจทย์ควอนไทซ์' },
  { id: 'dm', label: 'DM · Vocoder · วิดีโอ' },
  { id: 'line', label: '🎬 รหัสสัญญาณดิจิทัล 5 แบบ' },
  { id: 'table', label: 'ตารางสรุป 4 คู่' },
  { id: 'fast', label: '⚡ คิดไวในห้องสอบ' },
  { id: 'code', label: '💻 โค้ดรันได้' },
  { id: 'exam', label: '✸ ข้อสอบจับเวลา' },
  { id: 'check', label: 'เช็กเข้าใจ' },
  { id: 'summary', label: 'สรุป' },
];
---
<Base title="Week 5 — เทคนิคการเข้ารหัสสัญญาณ">
  <main class="wrap">
    <div class="crumb"><a href={`${base}/`}>หน้าแรก</a> / Week 5</div>
    <h2>Week 5 · เทคนิคการเข้ารหัสสัญญาณ</h2>
    <p class="hint">ข้อมูล ⇄ สัญญาณ 4 คู่ · ASK/FSK/MFSK/PSK/DPSK/QPSK/QAM · แบนด์วิดท์ + ประสิทธิภาพสเปกตรัม · AM/FM/PM/SSB · PCM/DM/Vocoder · NRZ/Manchester/AMI<br/>
      📌 <b>ที่มา:</b> สไลด์ 1–35 = คาบ 20 ก.ค. <b>มีไฟล์เสียง</b> → กล่องส้ม 🎙 คือคำพูดอาจารย์นอกสไลด์ · สไลด์ 36–66 (AM/FM → รหัสสัญญาณดิจิทัล) <b>ไม่มีไฟล์เสียงคาบนี้</b> — เรียบเรียงจากสไลด์ล้วน ไม่มีกล่อง 🎙 พร้อมป้ายกำกับทุกส่วน</p>

    <div class="shell">
      <WeekNav week={5} sections={sections} />
      <div class="lesson-main">

        <!-- ============ 1 ============ -->
        <Step kind="real" icon="🎯" title="ปัญหาที่บทนี้แก้: 'ข้อมูล' กับ 'สัญญาณ' ไม่ใช่สิ่งเดียวกัน" id="why">
          <p>สี่สัปดาห์ที่ผ่านมาเราสร้างเครื่องมือมาครบ: dB (W1) · โครงข่ายและโพรโทคอล (W2) · คลื่นกับเพดาน Nyquist/Shannon (W3) · สายอากาศและการเดินทางของคลื่น (W4) — แต่ยังมีช่องว่างหนึ่งที่ยังไม่ได้อุด</p>
          <p>คอมพิวเตอร์มีแต่ <b>0 กับ 1</b> · อากาศรับได้แต่ <b>คลื่นแม่เหล็กไฟฟ้าที่แกว่งต่อเนื่อง</b> — จะเอา 0/1 ยัดใส่อากาศตรง ๆ ไม่ได้ ต้องมีคนกลางแปลงให้ นั่นคือทั้งหมดของ Week 5: <span class="term">เทคนิคการเข้ารหัสสัญญาณ (signal encoding techniques)</span></p>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — วางกรอบทั้งบทตั้งแต่ต้นคาบ</span>
          อาจารย์เปิดคาบด้วยการให้ห้อง "วางรูป" ระบบสื่อสารเอง — <b>ตัวส่งประกอบด้วยอะไรบ้าง ตัวรับประกอบด้วยอะไรบ้าง</b> แล้วค่อยไล่ทีละกล่อง · ประโยคที่ย้ำคือ "<b>ข้อมูลเป็นได้ทั้ง analog หรือ digital · แล้วสัญญาณที่ส่งไปในสื่อ ก็เป็นได้ทั้ง analog หรือ digital ด้วย</b>" — สองแกนนี้คูณกันได้ 4 คู่ ซึ่งเป็นโครงของทั้งบท</div>
          <p class="why"><b>ทำไมวิศวกรคอมต้องรู้?</b> เพราะทุกตัวเลขความเร็วที่เราเห็นในชีวิตจริงเกิดจากบทนี้ — Wi-Fi ที่ขึ้น "หลายร้อย Mbps" ได้เพราะใช้ 256-QAM · โมเด็มยุคสายโทรศัพท์ติดเพดาน 56 kbps เพราะข้อจำกัดของบทนี้ · แม้แต่ QR code และซีดีเพลงก็เป็นการเข้ารหัสสัญญาณคนละแบบ · และเวลาดีบักปัญหาเครือข่ายไร้สาย คำว่า "modulation rate" กับ "data rate" ที่คนสับสนกันประจำ ก็อยู่ในบทนี้</p>
        </Step>

        <!-- ============ 2 ============ -->
        <Step kind="anim" icon="⛓" title="สายโซ่ของระบบสื่อสารไร้สาย — ทุกกล่องมีหน้าที่เดียวชัดเจน" id="chain">
          <p>สไลด์ 2–3 วางโครงทั้งระบบไว้เป็นสายโซ่ เดินทีละกล่องดูว่าใครทำอะไร (ฝั่งรับคือฝั่งส่งกลับหลัง):</p>
          <div id="chainStepper"></div>
          <p><b>จุดที่คนสับสนที่สุดคือสองกล่องแรก</b> — ทั้งคู่ชื่อ "encoder" เหมือนกันแต่คนละงาน:</p>
          <table class="tbl">
            <thead><tr><th>กล่อง</th><th>สนใจอะไร</th><th>เป้าหมาย</th><th>ตัวอย่าง</th></tr></thead>
            <tbody>
              <tr><td><b>ตัวเข้ารหัสแหล่งกำเนิด</b><br/>(source encoder)</td><td>ตัว<b>ข้อมูล</b>เอง</td><td>ตัดส่วนฟุ่มเฟือยทิ้ง ให้เล็กลง/มีประสิทธิภาพขึ้น</td><td>Vocoder · ตัวอักษร e (ใช้บ่อย) เข้ารหัสด้วยบิตน้อยกว่า q</td></tr>
              <tr><td><b>ตัวเข้ารหัสช่องสัญญาณ</b><br/>(channel encoder)</td><td><b>ความผิดพลาด</b>ที่ช่องสัญญาณจะก่อ</td><td><b>เพิ่ม</b>บิตเข้าไป เพื่อกู้คืนได้เมื่อข้อมูลพัง</td><td>FEC จาก Week 4 — ตัวเดียวกันเป๊ะ</td></tr>
            </tbody>
          </table>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — เส้นแบ่งของสองกล่องนี้</span>
          "แบบแรกที่เป็น source encoder <b>สนใจแค่ว่าแหล่งกำเนิดต้องการเข้ารหัส</b> · แต่ถ้าเป็น channel encoder อันนี้จะ<b>สนใจเรื่องของ error ที่เกิดขึ้นในช่องสัญญาณ</b>" — สังเกตทิศทางที่ตรงข้ามกัน: ตัวแรก<b>ลด</b>บิต ตัวหลัง<b>เพิ่ม</b>บิต</div>
          <p class="why">เชื่อมกับที่เคยเรียน <span class="plus">เสริมจากผู้เขียน</span>: source encoder คือแนวคิดเดียวกับการบีบอัดไฟล์ (zip/MP3/H.264) ส่วน channel encoder คือแนวคิดเดียวกับ checksum/parity แต่เก่งกว่าตรงที่<b>ซ่อมได้</b>ไม่ใช่แค่<b>ตรวจเจอ</b> — ทั้งคู่ทำงานสวนทางกันโดยตั้งใจ: บีบให้เล็กที่สุดก่อน แล้วค่อยเติมส่วนเกินที่ "ออกแบบมาอย่างดี" กลับเข้าไป</p>
        </Step>

        <!-- ============ 3 ============ -->
        <Step kind="deep" icon="⭐" title="Encoder ต่างจาก Modulator ยังไง — อาจารย์บอกเองว่าออกสอบ" id="encmod">
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — ประโยคที่ขึ้นต้นด้วย "อันนี้สำคัญนะ"</span>
          "<b>อันนี้สำคัญนะ Encoder กับ Modulator ต่างกันยังไง</b>" แล้วเฉลยเองว่า: ขาเข้าของทั้งคู่คือ<b>ข้อมูล</b> ซึ่งเป็น analog หรือ digital ก็ได้ · แต่<b>ขาออกต่างกันแน่นอน</b> — "ถ้าใช้ Encoder สัญญาณจะเป็น Digital" · "ผ่าน Modulator output จะเป็นสัญญาณ analog" · ปิดท้ายว่า "<b>ฉะนั้นถ้าเจอข้อสอบถามว่า encoder หรือ modulator เป็นยังไง จะได้ตอบได้</b>"</div>
          <table class="tbl">
            <thead><tr><th></th><th>ขาเข้า (input)</th><th>ขาออก (output)</th><th>ตัวคู่ที่ปลายทาง</th></tr></thead>
            <tbody>
              <tr><td><b>Encoder</b></td><td>ข้อมูล — analog หรือ digital ก็ได้</td><td><b>สัญญาณดิจิทัล</b> เสมอ</td><td>Decoder</td></tr>
              <tr><td><b>Modulator</b></td><td>ข้อมูล — analog หรือ digital ก็ได้</td><td><b>สัญญาณแอนะล็อก</b> เสมอ</td><td>Demodulator</td></tr>
            </tbody>
          </table>
          <p><b>วิธีจำที่ไม่ต้องท่อง:</b> modulator แปลว่า "ตัวมอดูเลต" = เอาข้อมูลไปฝากกับ<b>คลื่นพาห์</b> (carrier) ซึ่งเป็นคลื่นแอนะล็อก — ผลลัพธ์จึงต้องเป็นแอนะล็อกโดยธรรมชาติ · ส่วน encoder ไม่มีคลื่นพาห์เข้ามาเกี่ยว มันแค่จัดรูปเป็นรหัส 0/1</p>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — คำเตือนเรื่องคำถามหลอก</span>
          อาจารย์ถามห้องกลับว่า "input เป็น analog หรือ digital ก็ได้ <b>ขาออกเป็น analog อีกได้หรือเปล่า</b>" แล้วเฉลยว่า<b>ไม่ได้</b> — ขาออกต้องเรียกว่า "<b>สัญญาณ</b>" เสมอ (ขาเข้าคือ<b>ข้อมูล</b> ขาออกคือ<b>สัญญาณ</b>) การแยกคำสองคำนี้ให้ขาดคือกุญแจของทั้งบท</div>
          <h4 style="margin-top:20px">4 คู่ "ข้อมูล × สัญญาณ" และเหตุผลที่ต้องมีทั้งสี่ (สไลด์ 4–6)</h4>
          <table class="tbl">
            <thead><tr><th>ข้อมูล → สัญญาณ</th><th>เหตุผลที่เลือกใช้ (ตามสไลด์)</th></tr></thead>
            <tbody>
              <tr><td><b>ดิจิทัล → ดิจิทัล</b></td><td>อุปกรณ์<b>ซับซ้อนและแพงน้อยกว่า</b>อุปกรณ์ที่ต้องแปลงดิจิทัลเป็นแอนะล็อก</td></tr>
              <tr><td><b>แอนะล็อก → ดิจิทัล</b></td><td>ใช้การส่งดิจิทัลและอุปกรณ์<b>สวิตชิงสมัยใหม่</b>ได้ (เชื่อมกลับ Week 2!)</td></tr>
              <tr><td><b>ดิจิทัล → แอนะล็อก</b></td><td>สื่อบางชนิด<b>แพร่ได้เฉพาะสัญญาณแอนะล็อก</b> เช่น สายไฟเบอร์ และสื่อไร้สาย (unguided)</td></tr>
              <tr><td><b>แอนะล็อก → แอนะล็อก</b></td><td>ข้อมูลแอนะล็อกในรูปไฟฟ้า<b>ส่งได้ง่ายและถูกกว่า</b> · เช่น ส่งเสียงผ่านสายที่ใช้ส่งเสียงอยู่แล้ว</td></tr>
            </tbody>
          </table>
          <p class="why">สังเกตว่าเหตุผลทั้งสี่ข้อ<b>ไม่มีข้อไหนพูดถึงทฤษฎีเลย</b> — ทุกข้อคือเรื่อง "ราคา/ของที่มีอยู่/ข้อจำกัดของสื่อ" ล้วน ๆ นี่คือธรรมชาติของวิศวกรรมสื่อสาร: เลือกเทคนิคตาม<b>ข้อจำกัดจริง</b> ไม่ใช่ตามความสวยงามของสมการ <span class="plus">เสริมจากผู้เขียน</span></p>
        </Step>

        <!-- ============ 4 ============ -->
        <Step kind="intu" icon="📏" title="เกณฑ์ตัดสิน + ปัจจัยเปรียบเทียบ — อะไรคือ 'ดี' ในบทนี้" id="criteria">
          <p>สไลด์ 7 ตั้งคำถามว่า "อะไรบ่งบอกความสำเร็จของตัวรับ" คำตอบคือสัญญาณที่รับเข้ามาต้อง<b>ตีค่าได้</b> ซึ่งขึ้นกับ 3 ตัว:</p>
          <div class="formula">① SNR (อัตราส่วนสัญญาณต่อสัญญาณรบกวน)
② Data rate (อัตราการส่งข้อมูล)
③ Bandwidth (แบนด์วิดท์)

ความสัมพันธ์ที่ต้องจำ (สไลด์ 7):
   data rate ↑   →  BER ↑   (ส่งเร็วขึ้น ผิดพลาดง่ายขึ้น)
   SNR ↑         →  BER ↓   (สัญญาณชนะ noise มากขึ้น ผิดน้อยลง)
   bandwidth ↑   →  data rate ↑</div>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — สอน BER ด้วยการ "ตีเป็นภาษามนุษย์"</span>
          อาจารย์ไม่ยอมให้ท่องว่า 10⁻⁷ ดีกว่า 10⁻⁶ เฉย ๆ แต่ให้ห้องแปลงเป็นภาษาคนก่อน: <b>10⁻⁶ = ส่งไปหนึ่งล้านบิต ผิดหนึ่งบิต</b> · 10⁻⁷ = ส่งไปสิบล้านบิต ผิดหนึ่งบิต → "ฉะนั้นไหนดีกว่าครับ ลบ 6 กับลบ 7?" → <b>เลขยกกำลังยิ่งติดลบมาก ยิ่งดี</b> · แล้วอาจารย์ยังแยกให้ด้วยว่า "อัตรา" ตัวอื่น (data rate, baud rate) เทียบกับ<b>เวลา</b> แต่ <b>BER เทียบกับจำนวนบิต</b> ไม่ใช่เวลา — เป็นตัวเดียวที่ต่างออกไป</div>
          <p><b>ปัจจัยที่ใช้เปรียบเทียบรูปแบบการเข้ารหัส (สไลด์ 9–10)</b> — เวลาข้อสอบถามว่า "ทำไมเลือกวิธีนี้" ให้ตอบจาก 4 หัวข้อนี้:</p>
          <ul>
            <li><b>สเปกตรัมของสัญญาณ</b> — ไม่มีองค์ประกอบความถี่สูง = ใช้แบนด์วิดท์น้อยลง · ไม่มีองค์ประกอบ<b>กระแสตรง (DC)</b> = ใช้ AC coupling ผ่านหม้อแปลงได้ ทำให้แยกสัญญาณและลดการรบกวน · และควรส่งที่<b>กึ่งกลางแบนด์วิดท์</b> เพราะ transfer function ของช่องสัญญาณจะแย่ที่ขอบแถบ</li>
            <li><b>จังหวะเวลา (timing)</b> — หาจุดเริ่ม/จุดจบของแต่ละบิตในสัญญาณที่รับมาได้ง่ายแค่ไหน (เก็บไว้ตอบตอนเรียน Manchester ท้ายบท)</li>
            <li><b>การแทรกสอดและความทนต่อสัญญาณรบกวน</b> — เข้ารหัสแล้วยังอ่านออกไหมเมื่อมี noise</li>
            <li><b>ราคาและความซับซ้อน</b> — อยากได้ signaling rate สูงขึ้นเพื่อ data rate ที่ต้องการ ก็ต้องจ่ายแพงขึ้น</li>
          </ul>
        </Step>

        <!-- ============ 5 ============ -->
        <Step kind="deep" icon="🔢" title="bit rate vs baud rate — คู่คำที่คนในวงการยังสับสนกันอยู่" id="terms">
          <p>สไลด์ 8 ให้ศัพท์มา 4 คำ ซึ่งสองคำหลังคือหัวใจ:</p>
          <table class="tbl">
            <thead><tr><th>คำศัพท์</th><th>หน่วย</th><th>ความหมาย</th></tr></thead>
            <tbody>
              <tr><td>ข้อมูล (Data)</td><td>บิต</td><td>ไบนารี 1 หรือ 0</td></tr>
              <tr><td>อัตราการส่งข้อมูล (Data rate, R)</td><td>bps</td><td>อัตราที่<b>ข้อมูล</b>ถูกส่ง</td></tr>
              <tr><td>สัญลักษณ์ (Symbol)</td><td>ดิจิทัล = พัลส์แรงดันคงที่ · แอนะล็อก = พัลส์ของความถี่/มุมเฟส/แอมพลิจูดคงที่</td><td>ส่วนของสัญญาณที่จองช่วงเวลา<b>สั้นที่สุด</b>ของรหัสสัญญาณ</td></tr>
              <tr><td>อัตราการส่งสัญญาณ / อัตราการมอดูเลต (Baud rate, D)</td><td>baud หรือ symbols/sec</td><td>อัตราที่<b>สัญลักษณ์</b>ถูกส่ง</td></tr>
            </tbody>
          </table>
          <div class="formula">D = R/L = R / log₂M

   D = baud rate (สัญลักษณ์/วินาที)     R = bit rate (bps)
   M = จำนวนระดับของสัญญาณ = 2^L        L = จำนวนบิตต่อสัญลักษณ์</div>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — กฎที่ย้ำ 3 รอบติด</span>
          "<b>Baud rate จะมีค่าน้อยกว่าหรือเท่ากับ bit rate เสมอ</b>" — พร้อมเหตุผลว่า "เพราะมันหารอยู่" · ถ้า M = 2 → baud rate เท่ากับ bit rate พอดี · ถ้า M มากกว่า 2 → baud rate น้อยกว่าเสมอ</div>
          <h4 style="margin-top:18px">🧪 โจทย์ที่อาจารย์ถามสดในห้อง — QPSK ที่ 1 Mbps</h4>
          <div id="walkBaud"></div>
          <p class="why"><b>ทำไมต้องแยกสองคำนี้ให้ขาด?</b> <span class="plus">เสริมจากผู้เขียน</span> เพราะ<b>แบนด์วิดท์ที่ต้องใช้ผูกกับ baud rate ไม่ใช่ bit rate</b> — นี่คือเหตุผลทั้งหมดที่โลกวิ่งไปหา QAM ระดับสูง ๆ: อยากได้ bit rate เยอะโดยไม่ต้องขอแบนด์วิดท์เพิ่ม ก็ต้องยัดบิตต่อสัญลักษณ์ให้มากขึ้น (ราคาที่จ่ายคือ ทนสัญญาณรบกวนได้น้อยลง — จุดในกลุ่มดาวเบียดกัน)</p>
        </Step>

        <!-- ============ 6 ============ -->
        <Step kind="anim" icon="〰️" title="ดิจิทัล → แอนะล็อก: เล่นได้ 3 อย่างเท่านั้น" id="mod">
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — วางกรอบก่อนลงรายละเอียด</span>
          "ถ้าเราพูดถึงสัญญาณ analog สิ่งที่เราเล่นได้จะมี <b>3 ส่วน</b> ก็คือ <b>Amplitude, Frequency และ Phase</b>" → จึงเกิดชื่อสามชื่อ: Amplitude Shift Keying, Frequency Shift Keying, Phase Shift Keying · และย้ำว่าสัญญาณที่ส่งออกไป "<b>เป็น analog ทั้งหมด แต่เป็นการส่งข้อมูลที่เป็น digital</b>"</div>
          <p>คำว่า <b>keying</b> (จากคำว่า "key" = กด) หมายถึงการ<b>สลับค่าเป็นขั้น ๆ ตามบิต</b> ต่างจากการมอดูเลตแอนะล็อกที่ค่าไหลต่อเนื่อง — กดคีย์ให้ครบทั้ง 4 แบบจากบิตชุดเดียวกัน:</p>
          <div id="modStepper"></div>
          <table class="tbl">
            <thead><tr><th>วิธี</th><th>สมการจากสไลด์</th><th>ข้อสังเกต / ข้อจำกัด (ตามสไลด์)</th></tr></thead>
            <tbody>
              <tr><td><b>ASK</b><br/>(สไลด์ 13–14)</td><td>บิต 1 → A·cos(2πf_c t) · บิต 0 → 0<br/>(หนึ่งค่าไบนารีแทนด้วยคลื่นพาห์ อีกค่าแทนด้วย<b>การไม่มี</b>คลื่นพาห์)</td><td>ถูกกระทบง่ายจากการเปลี่ยนแปลงการขยายแบบกะทันหัน · เป็นเทคนิค<b>ที่ไม่มีประสิทธิภาพ</b> · ในสายโทรศัพท์ทำได้สูงสุด 1200 bps · <b>ใช้ส่งข้อมูลดิจิทัลบนสายใยแก้วนำแสง</b></td></tr>
              <tr><td><b>BFSK</b><br/>(สไลด์ 15–16)</td><td>บิต 1 → A·cos(2πf₁t) · บิต 0 → A·cos(2πf₂t)<br/>f₁, f₂ ห่างจาก f_c เท่ากันคนละทาง</td><td>ผิดพลาด<b>น้อยกว่า ASK</b> · สายโทรศัพท์สูงสุด 1200 bps · ใช้กับวิทยุความถี่สูง 3–30 MHz · ใช้ที่ความถี่สูงกว่าได้ใน LAN สายโคแอ็กซ์</td></tr>
              <tr><td><b>BPSK</b><br/>(สไลด์ 22)</td><td>ใช้ 2 เฟสห่างกัน 180°<br/>บิต 1 → A·cos(2πf_c t) · บิต 0 → A·cos(2πf_c t + π) = <b>−</b>A·cos(2πf_c t)</td><td>ทนสัญญาณรบกวนดีที่สุดในสามแบบ (ดูกราฟ BER ในหัวข้อประสิทธิภาพ)</td></tr>
              <tr><td><b>DPSK</b><br/>(สไลด์ 23)</td><td>เฟสเปลี่ยนโดย<b>อ้างอิงบิตก่อนหน้า</b><br/>บิต 0 = เฟสเดียวกับสัญญาณก่อนหน้า · บิต 1 = เฟสตรงข้าม</td><td>ไม่ต้องรู้เฟสอ้างอิงสัมบูรณ์ → ตัวรับง่ายขึ้น</td></tr>
            </tbody>
          </table>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — อธิบาย BPSK ด้วยวงกลม</span>
          "ในแบบไบนารี มีแค่ 2 จุด ถูกไหม · <b>1 วงมี 360 องศา ถ้าหาร 2 จะกลายเป็น 180</b> · แสดงว่า 2 จุดห่างกัน 180 องศา" — แล้วโยงกับสมการว่า A·cos(…+π) ก็คือ <b>−A·cos(…)</b> นั่นเอง "0 กับ 1 ก็คือสลับกันคนละขั้ว"</div>
          <p class="why"><b>อ่านกราฟให้เป็น:</b> ในภาพเคลื่อนไหวข้างบน สังเกตว่า ASK มีช่วง "เงียบ" (บิต 0 ไม่มีคลื่นเลย) ซึ่งเป็นจุดอ่อน — ถ้าสัญญาณอ่อนลงกะทันหัน ตัวรับแยกไม่ออกว่า "ส่ง 0" หรือ "สัญญาณหาย" · ส่วน FSK และ PSK มีคลื่นตลอดเวลา แอมพลิจูดคงที่ จึงทนกว่า <span class="plus">เสริมจากผู้เขียน</span></p>
        </Step>

        <!-- ============ 7 ============ -->
        <Step kind="anim" icon="🎹" title="MFSK — จาก 2 ความถี่เป็น M ความถี่ (ยัดหลายบิตใน 1 สัญลักษณ์)" id="mfsk">
          <p>สไลด์ 17–20: ถ้าใช้แค่ 2 ความถี่ 1 สัญลักษณ์แทนได้ 1 บิต — แต่ถ้ามี M ความถี่ 1 สัญลักษณ์แทนได้ <b>L = log₂M บิต</b></p>
          <div class="formula">sᵢ(t) = A·cos(2πfᵢt)        โดย  fᵢ = f_c + (2i − 1 − M)·f_d

   f_c = ความถี่คลื่นพาห์            f_d = ความแตกต่างของความถี่
   M   = จำนวนความแตกต่างของส่วนย่อยของสัญญาณ = 2^L
   L   = จำนวนบิตต่อส่วนย่อยของสัญญาณ

คาบสัญลักษณ์:  Ts = L·T      (T = คาบของบิต, data rate = 1/T)
แบนด์วิดท์:     BW = 2M·f_d   (ความถี่ต่ำสุดที่แยกออกจากกันได้คือ 2f_d = 1/Ts)</div>
          <div id="mfskStepper"></div>
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — วิธีนับบิตต่อสัญลักษณ์</span>
          "ถ้ามี 4 ความถี่ 1 ความถี่ก็คือ 2 บิต · <b>ถ้ามี 8 ความถี่ 1 ความถี่ก็จะเท่ากับ 3 บิต</b>" · แล้วสรุปว่า "ถ้าเราใช้ความถี่เยอะ ๆ ในการส่งข้อมูล มันสามารถส่งได้เยอะ" — แลกกับแบนด์วิดท์ที่กว้างขึ้นและโอกาสผิดพลาดที่มากขึ้น (ตรงกับสไลด์ 17)</div>
          <h4 style="margin-top:18px">🧪 โจทย์สไลด์ 21 — อาจารย์เดินสดในห้อง (เดินตามทีละขั้น)</h4>
          <div id="walkMFSK"></div>
        </Step>

        <!-- ============ 8 ============ -->
        <Step kind="deep" icon="🧭" title="QPSK และ Multilevel PSK — หั่นวงกลมให้ละเอียดขึ้น" id="mpsk">
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — จุดกำเนิดของ QPSK</span>
          "ใน 1 วงเอง มัน<b>ไม่จำเป็นต้องห่างกัน 180 องศา</b> · มันสามารถที่จะห่างกันแค่ <b>90 องศา</b> ก็ได้ มันก็เลยทำให้เป็น <b>QPSK</b> หรือ Quadrature PSK" · แล้วชวนนับว่า "1 วง เราส่งได้ทั้งหมด 4 สัญลักษณ์ ฉะนั้น 1 สัญลักษณ์แทนที่ได้ 2 บิต"</div>
          <p>สไลด์ 24 เขียน QPSK เป็น 4 เฟสที่ π/4, 3π/4, 5π/4, 7π/4 (เอียง 45° จากแกน) ซึ่งเป็นเหตุผลที่ diagram บนสไลด์ 25 วางจุด 4 จุดเป็นสี่เหลี่ยมเอียง โดยแต่ละจุดกำกับด้วย 2 บิต: <b>11 (45°) · 01 (135°) · 00 (225°) · 10 (315°)</b> — ลองเทียบกับ Constellation Lab ข้างล่างได้ ป้ายบิตวางตามสไลด์เป๊ะ</p>
          <p><b>Multilevel PSK (สไลด์ 26):</b> ใช้มุมเฟสหลาย ๆ มุม และแต่ละมุมมีได้มากกว่า 1 แอมพลิจูด — อัตราการส่งสัญลักษณ์คำนวณจาก D = R/L = R/log₂M (สูตรเดียวกับที่ใช้ไปแล้ว)</p>
          <div class="note">📌 <b>OQPSK</b> ที่โผล่ในชื่อสไลด์ 25 (Offset QPSK) คือ QPSK ที่<b>หน่วงช่อง Q ไว้ 1 คาบบิต</b> (กล่อง "Delay T_b" ในบล็อกไดอะแกรม) เพื่อไม่ให้เฟสกระโดด 180° ในทีเดียว — ช่วยให้ซองแอมพลิจูดเรียบขึ้น <span class="plus">เสริมจากผู้เขียน — สไลด์แสดงเป็นบล็อกไดอะแกรม ไม่ได้อธิบายเป็นข้อความ</span></div>
        </Step>

        <!-- ============ 9 ============ -->
        <Step kind="anim" icon="✨" title="QAM — เอาแอมพลิจูดกับเฟสมาเล่นพร้อมกัน" id="qam">
          <div class="lect"><span class="who">🎙 จากปากอาจารย์ — นิยาม QAM แบบสั้นที่สุด</span>
          "QAM = Quadrature Amplitude Modulation · อันนี้จะเป็นเทคนิคที่<b>ใช้ทั้ง ASK และ PSK</b>" · แล้วอธิบายจาก constellation ของ 16QAM ว่า "จากจุด 0 ไปหาจุดใด ๆ มันจะมีทั้ง<b>มุมเดียวกันแต่คนละแอมพลิจูด</b> หรือ<b>แอมพลิจูดเดียวกันแต่คนละมุม</b>"</div>
          <p>สไลด์ 33: QAM คือการรวมกันของ ASK และ PSK — สองสัญญาณที่แตกต่างกันถูกส่งพร้อมกันในความถี่พาห์เดียวกัน (ช่อง I และ Q ที่ต่างเฟส 90°) · สไลด์ 35 เรียกแผนภาพจุดเหล่านี้ว่า <span class="term">Constellation diagram (แผนภูมิกลุ่มดาว)</span> — มุมของจุด = มุมเฟส · ระยะจากจุดกำเนิด = แอมพลิจูด</p>
